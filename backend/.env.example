# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Base de datos
# PostgreSQL. Levanta una instancia local con `docker compose -f ../config/docker-compose.yml up -d`
# (o usa `scripts/dev.ps1`, que hace esto automáticamente) — credenciales de ese compose:
DATABASE_URL="postgresql://pitstop:pitstop@localhost:5432/pitstop?schema=public"

# Autenticación
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
